# Browser: use a Supabase publishable key (or legacy anon key), never service_role.
# Leave both empty to use a locally prepared snapshot (not included in Git).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Importer only; never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
