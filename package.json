{
  "name": "intaru",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm data:prepare && pnpm build:app",
    "build:app": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test src/lib/geo.test.ts src/lib/map-symbols.test.ts src/lib/map-preferences.test.ts src/lib/location-results.test.ts src/lib/layers.test.ts src/lib/region-search.test.ts src/lib/facilities.test.ts src/lib/hazards.test.ts src/lib/region-view.test.ts scripts/export-apps-script.test.mjs scripts/display-geometry.test.mjs scripts/population.test.mjs",
    "data:export": "node scripts/export-apps-script.mjs --all",
    "data:enrich": "node --experimental-strip-types scripts/export-enrichment.mjs",
    "data:prepare": "node --experimental-strip-types scripts/prepare-data.mjs && node --experimental-strip-types scripts/prepare-enrichment.mjs",
    "data:import": "node --env-file=.env scripts/import-supabase.mjs",
    "data:import:assets": "node --env-file=.env scripts/import-supabase.mjs --assets-only",
    "data:import:enrichment": "node --env-file=.env scripts/import-enrichment.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "@tanstack/react-query": "^5.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-aria-components": "^1.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@turf/difference": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "@types/geojson": "^7946.0.0",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fflate": "^0.8.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
